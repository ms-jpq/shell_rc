# https://github.com/gokcehan/lf/blob/master/doc.md
# https://github.com/gokcehan/lf/blob/master/etc/lfrc.example

set findlen    2
set globfilter true
set globsearch true
set hidden     true
set icons      true
set locale     "*"
set mouse      true
set previewer  "~/.config/lf/preview.sh"
set wrapscroll true

cmd open       &true
map <s-down>   :toggle; down
map <s-up>     :toggle; up
map <space>    :toggle
map d          delete
map x          cut
