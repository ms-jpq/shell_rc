# https://github.com/gokcehan/lf/blob/master/doc.md
# https://github.com/gokcehan/lf/blob/master/etc/lfrc.example

set drawbox        true
set hidden         true
set icons          true
set incfilter      true
set incsearch      true
set infotimefmtnew "06-01-02 15:04"
set infotimefmtold "06-01-02 15:04"
set locale         "*"
set mouse          true
set period         2
set previewer      "~/.config/lf/preview.sh"
set roundbox       true
set scrolloff      3
set sixel          true
set tabstop        2
set timefmt        "06-01-02 15:04"
set wrapscroll     true

cmd open           &true
cmd user-open      &"$OPENER" "$f"

map <s-down>       :toggle; down
map <s-up>         :toggle; up
map <space>        :toggle
map d              delete
map f              :filter
map F              :setfilter
map o              :user-open
map x              cut

map i
map a              push %mkpath.sh<space>

cmd mkpath         %mkpath.sh "$*" && lf -remote "send $id load" && lf -remote "send $id select $1"
