{
  "#": "https://github.com/helix-editor/helix/blob/master/languages.toml",
  "$": [],
  "language": {
    "awk": {
      "formatter": {
        "command": "awk-fmt"
      }
    },
    "bash": {
      "formatter": {
        "args": [
          "--simplify",
          "--binary-next-line",
          "--space-redirects",
          "--indent=2"
        ],
        "command": "shfmt"
      }
    },
    "c": {
      "formatter": {
        "args": ["-Werror"],
        "command": "clang-format"
      }
    },
    "clojure": {
      "formatter": {
        "args": [
          "fix",
          "--remove-multiple-non-indenting-spaces",
          "--split-keypairs-over-multiple-lines",
          "--",
          "-"
        ],
        "command": "cljfmt"
      }
    },
    "css": {},
    "devicetree": {
      "formatter": {
        "args": ["--stdin"],
        "command": "dtsfmt"
      }
    },
    "dockerfile": {
      "formatter": {
        "args": ["format", "--spaces=2"],
        "command": "dockerfile-utils"
      }
    },
    "fortran": {
      "formatter": {
        "args": [],
        "command": "fprettify"
      }
    },
    "fsharp": {
      "formatter": {
        "args": ["%{buffer_name}"],
        "command": "fantomas"
      }
    },
    "go": {
      "auto-pairs": {
        "\"": "\"",
        "'": "'",
        "(": ")",
        "`": "`",
        "{": "}"
      },
      "formatter": {
        "args": [],
        "command": "goimports"
      }
    },
    "haskell": {
      "formatter": {
        "args": [],
        "command": "stylish"
      }
    },
    "hcl": {
      "formatter": {
        "args": ["fmt", "-"],
        "command": "terraform"
      }
    },
    "html": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "run-prettier"
      }
    },
    "java": {
      "formatter": {
        "args": ["-"],
        "command": "javafmt"
      }
    },
    "javascript": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "run-prettier"
      }
    },
    "json": {
      "formatter": {
        "args": ["--tabsize=2"],
        "command": "json-fmt"
      }
    },
    "kotlin": {
      "formatter": {
        "args": ["2", "--stdin-name=%{buffer_name}", "-"],
        "command": "ktfmt"
      }
    },
    "latex": {
      "formatter": {
        "command": "latexindent"
      },
      "language-servers": ["ltex-ls-plus"]
    },
    "lua": {
      "formatter": {
        "args": [
          "--syntax=LuaJit",
          "--indent-type=Spaces",
          "--indent-width=2",
          "--sort-requires",
          "--call-parentheses=None",
          "--",
          "-"
        ],
        "command": "stylua"
      }
    },
    "mail": {
      "language-servers": ["ltex-ls-plus"]
    },
    "markdown": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "markdown-fmt"
      },
      "language-servers": ["ltex-ls-plus"]
    },
    "nginx": {
      "file-types": ["nginx"],
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "run-prettier"
      }
    },
    "perl": {
      "formatter": {
        "args": ["--indent-columns=2"],
        "command": "perltidy"
      }
    },
    "php": {
      "formatter": {
        "args": [],
        "command": "cs-fixer"
      },
      "language-servers": ["phpactor"]
    },
    "powershell": {
      "formatter": {
        "command": "pwsh-fmt"
      },
      "language-servers": ["powershell-lsp"]
    },
    "prolog": {
      "formatter": {
        "command": "prolog-fmt"
      }
    },
    "python": {
      "formatter": {
        "args": [],
        "command": "isort-black"
      },
      "language-servers": ["pyright"]
    },
    "r": {
      "formatter": {
        "args": [],
        "command": "styler"
      }
    },
    "ruby": {
      "formatter": {
        "args": [
          "%{buffer_name}",
          "--fail-level=fatal",
          "--stderr",
          "--stdin",
          "--format=quiet",
          "--no-color",
          "--autocorrect"
        ],
        "command": "rubocop"
      },
      "language-servers": ["srb"]
    },
    "rust": {
      "formatter": {
        "args": ["--edition=2021"],
        "command": "rustfmt"
      }
    },
    "scss": {},
    "sql": {
      "formatter": {
        "args": ["--language=postgres"],
        "command": "sql-formatter"
      }
    },
    "systemd": {
      "formatter": {
        "command": "systemd-fmt.sh"
      }
    },
    "toml": {
      "formatter": {
        "args": [
          "format",
          "--option=align_entries=true",
          "--option=array_trailing_comma=true",
          "--option=reorder_keys=true",
          "--",
          "-"
        ],
        "command": "taplo"
      }
    },
    "typescript": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "run-prettier"
      }
    },
    "xml": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "run-prettier"
      },
      "language-servers": ["lemminx"]
    },
    "yaml": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "run-prettier"
      }
    }
  },
  "language-server": {
    "copilot-language-server": {
      "args": ["--stdio"],
      "command": "copilot-language-server"
    },
    "intelephense": {
      "config": {
        "globalStoragePath": "/var/tmp/intelephense"
      }
    },
    "lemminx": {
      "args": ["-Dlemminx.workdir=/var/tmp/lemminx"],
      "command": "lemminx"
    },
    "lua-language-server": {
      "command": "lua-language-server"
    },
    "phpactor": {
      "args": ["language-server"],
      "command": "phpactor"
    },
    "powershell-lsp": {
      "args": [],
      "command": "powershell-lsp"
    },
    "r": {
      "command": "r-lsp"
    },
    "solargraph": {
      "command": "solargraph"
    },
    "srb": {
      "args": ["tc", "--lsp"],
      "command": "srb"
    }
  }
}
