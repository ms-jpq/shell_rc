{
  "#": "https://github.com/helix-editor/helix/blob/master/languages.toml",
  "$": ["tabby", "helix-gpt", "typos"],
  "language": {
    "bash": {
      "formatter": {
        "args": [
          "--simplify",
          "--binary-next-line",
          "--space-redirects",
          "--indent=2"
        ],
        "command": "shfmt"
      }
    },
    "c": {
      "formatter": {
        "args": ["-Werror"],
        "command": "clang-format"
      }
    },
    "clojure": {
      "formatter": {
        "args": [
          "fix",
          "--remove-multiple-non-indenting-spaces",
          "--sort-ns-reference",
          "--split-keypairs-over-multiple-lines",
          "--",
          "-"
        ],
        "command": "cljfmt"
      }
    },
    "css": {},
    "dockerfile": {
      "formatter": {
        "args": ["format", "--spaces=2"],
        "command": "dockerfile-utils"
      }
    },
    "fortran": {
      "formatter": {
        "args": [],
        "command": "fprettify"
      }
    },
    "fsharp": {
      "formatter": {
        "args": ["%{buffer_name}"],
        "command": "fantomas.fsx"
      }
    },
    "go": {
      "formatter": {
        "args": [],
        "command": "goimports"
      }
    },
    "haskell": {
      "formatter": {
        "command": "stylish-haskell"
      }
    },
    "hcl": {
      "formatter": {
        "args": ["fmt", "-"],
        "command": "terraform"
      }
    },
    "html": {},
    "java": {
      "formatter": {
        "args": ["-"],
        "command": "javafmt.java"
      }
    },
    "javascript": {
      "formatter": {
        "args": ["--tabsize=2", "--sort", "--filename", "%{buffer_name}"],
        "command": "prettier.js"
      }
    },
    "jq": {},
    "json": {
      "formatter": {
        "args": ["--tabsize=2"],
        "command": "json-fmt.js"
      }
    },
    "kotlin": {
      "formatter": {
        "args": ["2", "-"],
        "command": "ktfmt.java"
      }
    },
    "latex": {
      "formatter": {
        "command": "latexindent.pl"
      },
      "language-servers": ["ltex-ls-plus"]
    },
    "lua": {
      "formatter": {
        "args": ["--line-width=88", "--indent-count=2", "--stdin"],
        "command": "luafmt"
      }
    },
    "mail": {
      "language-servers": ["ltex-ls-plus"]
    },
    "markdown": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "prettier.js"
      },
      "language-servers": ["ltex-ls-plus"]
    },
    "perl": {
      "formatter": {
        "args": ["--indent-columns=2"],
        "command": "perltidy.pl"
      }
    },
    "php": {
      "formatter": {
        "args": [],
        "command": "cs-fixer.php"
      },
      "language-servers": ["phpactor"]
    },
    "powershell": {
      "formatter": {
        "command": "pwsh-fmt.ps1"
      },
      "language-servers": ["powershell-es"]
    },
    "prolog": {
      "formatter": {
        "command": "prolog-fmt.pro"
      }
    },
    "python": {
      "formatter": {
        "args": [],
        "command": "isort-black.py"
      },
      "language-servers": ["pyright"]
    },
    "r": {
      "formatter": {
        "args": [],
        "command": "styler.R"
      }
    },
    "ruby": {
      "formatter": {
        "args": [
          "%{buffer_name}",
          "--fail-level=fatal",
          "--stderr",
          "--stdin",
          "--format=quiet",
          "--no-color",
          "--autocorrect"
        ],
        "command": "rubocop.rb"
      },
      "language-servers": ["ruby-lsp", "solargraph", "sorbet"]
    },
    "rust": {
      "formatter": {
        "args": ["--edition=2021"],
        "command": "rustfmt"
      }
    },
    "scss": {},
    "sql": {
      "formatter": {
        "args": ["--language=postgres"],
        "command": "sql-formatter"
      }
    },
    "systemd": {
      "formatter": {
        "command": "systemd-fmt.sh"
      }
    },
    "toml": {
      "formatter": {
        "args": [
          "format",
          "--option=align_entries=true",
          "--option=array_trailing_comma=true",
          "--option=reorder_keys=true",
          "--",
          "-"
        ],
        "command": "taplo"
      }
    },
    "typescript": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "prettier.js"
      }
    },
    "xml": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "prettier.js"
      },
      "language-servers": ["lemminx"]
    },
    "yaml": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "prettier.js"
      }
    }
  },
  "language-server": {
    "helix-gpt": {
      "command": "helix-gpt"
    },
    "lemminx": {
      "args": [],
      "command": "lemminx"
    },
    "phpactor": {
      "args": ["language-server"],
      "command": "phpactor.phar"
    },
    "powershell-es": {
      "args": [],
      "command": "pwsh-es.ps1"
    },
    "r": {
      "command": "lsp.R"
    },
    "sorbet": {
      "args": ["tc", "--lsp"],
      "command": "srb"
    },
    "tabby": {
      "args": ["--lsp", "--stdio"],
      "command": "tabby-agent"
    }
  }
}
