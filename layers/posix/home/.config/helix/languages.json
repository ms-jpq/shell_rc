{
  "#": "https://github.com/helix-editor/helix/blob/master/languages.toml",
  "$": [],
  "language": {
    "bash": {
      "formatter": {
        "args": [
          "--simplify",
          "--binary-next-line",
          "--space-redirects",
          "--indent=2"
        ],
        "command": "shfmt"
      }
    },
    "c": {
      "formatter": {
        "args": ["-Werror"],
        "command": "clang-format"
      }
    },
    "clojure": {
      "formatter": {
        "args": [
          "fix",
          "--remove-multiple-non-indenting-spaces",
          "--split-keypairs-over-multiple-lines",
          "--",
          "-"
        ],
        "command": "cljfmt"
      }
    },
    "css": {},
    "dockerfile": {
      "formatter": {
        "args": ["format", "--spaces=2"],
        "command": "dockerfile-utils"
      }
    },
    "fortran": {
      "formatter": {
        "args": [],
        "command": "fprettify"
      }
    },
    "fsharp": {
      "formatter": {
        "args": ["%{buffer_name}"],
        "command": "fantomas.fsx"
      }
    },
    "go": {
      "auto-pairs": {
        "\"": "\"",
        "'": "'",
        "(": ")",
        "`": "`",
        "{": "}"
      },
      "formatter": {
        "args": [],
        "command": "goimports"
      }
    },
    "haskell": {
      "formatter": {
        "args": [],
        "command": "stylish"
      }
    },
    "hcl": {
      "formatter": {
        "args": ["fmt", "-"],
        "command": "terraform"
      }
    },
    "html": {},
    "java": {
      "formatter": {
        "args": ["-"],
        "command": "javafmt.jsh"
      }
    },
    "javascript": {
      "formatter": {
        "args": ["--tabsize=2", "--sort", "--filename", "%{buffer_name}"],
        "command": "prettier.js"
      }
    },
    "jq": {
      "formatter": {
        "command": "jqfmt"
      }
    },
    "json": {
      "formatter": {
        "args": ["--tabsize=2"],
        "command": "json-fmt.js"
      }
    },
    "kotlin": {
      "formatter": {
        "args": ["2", "--stdin-name=%{buffer_name}", "-"],
        "command": "ktfmt.jsh"
      }
    },
    "latex": {
      "formatter": {
        "command": "latexindent.pl"
      },
      "language-servers": ["ltex-ls-plus"]
    },
    "lua": {
      "formatter": {
        "args": ["--line-width=88", "--indent-count=2", "--stdin"],
        "command": "luafmt"
      }
    },
    "mail": {
      "language-servers": ["ltex-ls-plus"]
    },
    "markdown": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "prettier.js"
      },
      "language-servers": ["ltex-ls-plus"]
    },
    "perl": {
      "formatter": {
        "args": ["--indent-columns=2"],
        "command": "perltidy.pl"
      }
    },
    "php": {
      "formatter": {
        "args": [],
        "command": "cs-fixer.php"
      },
      "language-servers": ["phpactor"]
    },
    "powershell": {
      "formatter": {
        "command": "pwsh-fmt.ps1"
      },
      "language-servers": ["powershell-es"]
    },
    "prolog": {
      "formatter": {
        "command": "prolog-fmt.pro"
      }
    },
    "python": {
      "formatter": {
        "args": [],
        "command": "isort-black.py"
      },
      "language-servers": ["pyright"]
    },
    "r": {
      "formatter": {
        "args": [],
        "command": "styler.R"
      }
    },
    "ruby": {
      "formatter": {
        "args": [
          "%{buffer_name}",
          "--fail-level=fatal",
          "--stderr",
          "--stdin",
          "--format=quiet",
          "--no-color",
          "--autocorrect"
        ],
        "command": "rubocop.rb"
      },
      "language-servers": ["sorbet"]
    },
    "rust": {
      "formatter": {
        "args": ["--edition=2021"],
        "command": "rustfmt"
      }
    },
    "scss": {},
    "sql": {
      "formatter": {
        "args": ["--language=postgres"],
        "command": "sql-formatter"
      }
    },
    "systemd": {
      "formatter": {
        "command": "systemd-fmt.sh"
      }
    },
    "toml": {
      "formatter": {
        "args": [
          "format",
          "--option=align_entries=true",
          "--option=array_trailing_comma=true",
          "--option=reorder_keys=true",
          "--",
          "-"
        ],
        "command": "taplo"
      }
    },
    "typescript": {
      "formatter": {
        "args": ["%{buffer_name}"],
        "command": "eslint.js"
      }
    },
    "xml": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "prettier.js"
      },
      "language-servers": ["lemminx"]
    },
    "yaml": {
      "formatter": {
        "args": ["--tabsize=2", "--filename", "%{buffer_name}"],
        "command": "prettier.js"
      },
      "language-servers": ["stainless"]
    }
  },
  "language-server": {
    "chatty": {
      "args": ["--stdio"],
      "command": "copilot-language-server"
    },
    "fsharp-ls": {
      "command": "fsautocomplete.fsx"
    },
    "helix-gpt": {
      "args": [
        "--numSuggestions",
        "1",
        "--handler",
        "copilot",
        "--copilotModel",
        "claude-sonnet-4-0"
      ],
      "command": "helix-gpt"
    },
    "intelephense": {
      "config": {
        "globalStoragePath": "/var/tmp/intelephense"
      }
    },
    "lemminx": {
      "args": [],
      "command": "lemminx"
    },
    "lua-language-server": {
      "command": "lua-language-server.sh"
    },
    "omnisharp": {
      "command": "omnisharp.fsx"
    },
    "phpactor": {
      "args": ["language-server"],
      "command": "phpactor.phar"
    },
    "powershell-es": {
      "args": [],
      "command": "pwsh-es.ps1"
    },
    "r": {
      "command": "lsp.R"
    },
    "sorbet": {
      "args": ["tc", "--lsp"],
      "command": "srb"
    },
    "stainless": {
      "args": ["--stdio"],
      "command": "stainless-language-server"
    },
    "tabby": {
      "args": ["--stdio"],
      "command": "tabby-agent"
    }
  }
}
