[apply]
ignoreWhitespace = "change"

[blame]
coloring = "highlightRecent"

[branch]
autoSetupMerge  = "always"
autoSetupRebase = "always"
sort            = "-committerdate"

[checkout]
thresholdForParallelism = 1
workers                 = 0

[clone]
filterSubmodules = true

[column]
ui = "auto"

[commit]
cleanup = "scissors"
verbose = true

[core]
autocrlf = "input"
pager    = "delta"
safecrlf = true
symlinks = true

[delta]
hyperlinks     = true
light          = true
line-numbers   = true
navigate       = true
relative-paths = true
tabs           = 2

[diff]
# noprefix         = true
algorithm        = "histogram"
colorMoved       = "dimmed-zebra"
colorMovedWS     = "ignore-space-change"
dirstat          = "files,cumulative"
guitool          = "gui"
interHunkContext = 2
mnemonicPrefix   = true
renameLimit      = 999999999
renames          = "copies"
submodule        = "log"
tool             = "nvimdiff"
wsErrorHighlight = "all"

[diff.cert]
cachetextconv = true
textconv      = "openssl x509 -noout -text -in"

[diff.dpkg]
textconv = "dpkg --info --"

[diff.exif]
textconv = "exiftool --"

[diff.gpg]
textconv = "gpg --list-packets --"

[diff.gpgkey]
textconv = "gpg --show-keys --"

[diff.pdf]
cachetextconv = true
textconv      = "pdftotext -q -nopgbrk -- - -"

[difftool]
prompt        = false
trustExitCode = true

[fetch]
all                  = true
negotiationAlgorithm = "skipping"
parallel             = 0
prune                = true
pruneTags            = true
# TODO: this segfaults git on ubuntu 24
# writeCommitGraph  = true

[gc]
worktreePruneExpire = "now"

[grep]
column            = true
fallbackToNoIndex = true
lineNumber        = true
patternType       = "perl"

[help]
autoCorrect = "prompt"

[init]
defaultBranch = "main"

[interactive]
diffFilter = "delta --color-only"
singleKey  = true

[log]
abbrevCommit = true
date         = "format-local:%y-%m-%d %H:%M"
decorate     = "short"

[maintenance]
strategy = "incremental"

[merge]
autostash        = true
conflictStyle    = "zdiff3"
directoryRenames = true
ff               = "only"
tool             = "nvimdiff"

[pager]
diff = "delta"

[pull]
rebase = true

[push]
autoSetupRemote    = true
default            = "current"
followTags         = true
recurseSubmodules  = "check"
useForceIfIncludes = true

[rebase]
autoSquash           = true
autoStash            = true
missingCommitsCheck  = "warn"
rescheduleFailedExec = true
stat                 = true
updateRefs           = true

[rerere]
autoUpdate = true
enabled    = true

[status]
renames          = "copies"
showStash        = true
submoduleSummary = true

[stash]
showIncludeUntracked = true
showPatch            = true

[submodule]
fetchJobs = 0
recurse   = true

[tag]
sort    = "-taggerdate"

# [transfer]
# fsckObjects = true

[user]
email = "git@bigly.dog"
name  = "dogisgreat"

[worktree]
guessRemote = false
