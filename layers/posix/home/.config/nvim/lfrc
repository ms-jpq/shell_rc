# layers/posix/home/.config/lf/lfrc

map e  &realpath --no-symlinks --relative-base "$NVIM_PWD" -- "$f" | xargs -r -0 -- "$EDITOR" && lf -remote "send $id quit"
map br $realpath --no-symlinks --relative-to   "$NVIM_PWD" -- "$f" | sed -E -z -e 's#\n$##'                            | ~/.config/zsh/bin/c
map bR $realpath --no-symlinks --relative-to   "$NVIM_PWD" -- "$f" | sed -E -z -e 's#\n$##' | xargs -0 -- printf -- %q | ~/.config/zsh/bin/c
