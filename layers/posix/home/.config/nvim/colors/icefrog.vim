runtime colors/iceberg.vim
let g:colors_name = 'icefrog'

highlight! CursorLine            guibg=#eae0f1 ctermbg=253
highlight! TreesitterContext     guibg=#d1e5ee ctermbg=254
highlight! HighlightedyankRegion cterm=reverse gui=reverse
highlight! EndOfBuffer           guibg=NONE    ctermbg=NONE
highlight! Normal                guibg=NONE    ctermbg=NONE
highlight! NormalNC              guibg=NONE    ctermbg=NONE
highlight! SignColumn            guibg=NONE    ctermbg=NONE
highlight! VertSplit             guibg=NONE    ctermbg=NONE
highlight! link                  @markup.quote Statement
highlight! link                  Conceal       Comment
highlight! link                  CursorColumn  CursorLine
highlight! link                  MatchParen    Search
highlight! link                  TabLineFill   Normal
highlight! link                  WinSeparator  LineNr
