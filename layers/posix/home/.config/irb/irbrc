module Kernel
  unless respond_to?(:clear!)
    def clear!
      system(*%w[clear --], exception: true)
    end
  end
  unless respond_to?(:methods!)
    def methods!
      (methods - Object.methods).sort
    end
  end
  unless respond_to?(:own_methods!)
    def own_methods!
      (methods - self.class.superclass.instance_methods).sort
    end
  end

  unless respond_to?(:assert!)
    def assert!(c, m = nil, &msg)
      raise(msg&.call || m) unless c

      c
    end
  end
end

class Module
  unless method_defined?(:edit!)
    def edit!
      case Object.const_source_location(name)
      in []
        warn(inspect)
      in [path, lineno]
        system(*ENV.fetch('EDITOR').shellsplit, "#{path}:#{lineno}")
      end
    end
  end
end

class Class
  unless method_defined?(:edit!)
    def edit!
      case Object.const_source_location(name)
      in []
        warn(inspect)
      in [path, lineno]
        system(*ENV.fetch('EDITOR').shellsplit, "#{path}:#{lineno}")
      end
    end
  end
end

class Method
  unless method_defined?(:edit!)
    def edit!
      source_location => [path, lineno]
      if File.file?(path.to_s)
        system(*ENV.fetch('EDITOR').shellsplit, "#{path}:#{lineno}")
      else
        warn(inspect)
      end
    end
  end
end
