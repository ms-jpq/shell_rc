(version 1)

(allow network*)

(allow file-read*
  (literal "/Library/Preferences/com.apple.networkd.plist")
  (literal "/private/var/run/resolv.conf"))

(allow network-outbound
  (literal "/private/var/run/mDNSResponder"))

;; ---- ---- ---- ----

(allow file-read*
  (subpath (xdg-config "curl")
           (xdg-config "wget")))
