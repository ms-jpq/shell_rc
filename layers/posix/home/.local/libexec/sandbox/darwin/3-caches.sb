(version 1)

(allow file-read* file-write*
  (subpath
    (xdg-cache "")
    (home ".local/asdf")
  ))

(allow network-bind
  (subpath (xdg-cache "")))

(allow network-outbound
  (regex
    (string-append "^" (xdg-cache "") "nvim\\.")))

(deny file-read* file-write*
  (regex
    (string-append "^" (xdg-cache "") "com\\.apple\\."))
  (subpath
    (xdg-cache "aerc")
    (xdg-cache "askpermissiond")
    (xdg-cache "CloudKit")
    (xdg-cache "containers")
    (xdg-cache "EnergyKit")
    (xdg-cache "Firefox")
    (xdg-cache "GameKit")
    (xdg-cache "GeoServices")
    (xdg-cache "icloudmailagent")
    (xdg-cache "isync")
    (xdg-cache "maildir")
    (xdg-cache "Mozilla")
    (xdg-cache "PassKit")
    (xdg-cache "SharedImageCache")
    (xdg-cache "SiriTTS")
  ))
