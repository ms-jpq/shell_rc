#!/usr/bin/env -S -- bash -Eeuo pipefail -O dotglob -O nullglob -O extglob -O failglob -O globstar

set -o pipefail
shopt -u failglob

: "${PATH?}"

RT="$HOME/.cache/helix-rt"
PATHS=(
  "$RT/"{more,go,ruby}/*/bin
  "$RT/php/"*/vendor/bin
  "$RT/nodejs"/*/node_modules/.bin
  "$RT/python"/*/venv/{Scripts,bin}
  "$PATH"
)
IFS=':'
PATH="${PATHS[*]}"

exec -- "$@"
