#!/usr/bin/env -S -- bash -Eeu -o pipefail -O dotglob -O nullglob -O extglob -O failglob -O globstar

set -o pipefail

for F in "$@"; do
  if ! [[ $F =~ ^https?:// ]] && ! [[ -r $F ]]; then
    printf -- "%q" "Not openable -- $F" >&2
    exit 2
  fi
done

if [[ -v TMUX ]]; then
  # shellcheck disable=SC2154
  RESOLVED="$("$XDG_CONFIG_HOME/tmux/libexec/which.sh")"
  read -r -- PANE SOCKET <<< "$RESOLVED"

  TM=(tmux -S "$SOCKET")

  PANES="$("${TM[@]}" display-message -p -t "$PANE" -- '#{window_panes}')"
  if ((PANES == 1)); then
    ARGV=("${TM[@]}" split-window -h -t "$PANE")
  else
    ARGV=("${TM[@]}" new-window -a -t "$PANE")
  fi

  FOCUS="$("${TM[@]}" display-message -p -t "$PANE" -- '#{&&:#{session_attached},#{&&:#{window_active},#{pane_active}}}')"
  if ! ((FOCUS)); then
    ARGV+=(-d)
  fi

  if [[ -d $* ]]; then
    ARGV+=(-c "$*")
    exec -- "${ARGV[@]}"
  fi

  # shellcheck disable=SC2154
  exec -- "${ARGV[@]}" -- "$EDITOR" "$@"
else
  exec -- open -- "$@"
fi
