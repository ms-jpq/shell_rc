#!/usr/bin/env -S -- bash -Eeu -o pipefail -O dotglob -O nullglob -O extglob -O failglob -O globstar

set -o pipefail

for F in "$@"; do
  if ! [[ $F =~ ^https?:// ]] && ! [[ -r $F ]]; then
    printf -- "%q" "Not openable -- $F" >&2
    exit 2
  fi
done

if [[ -v TMUX ]]; then
  if TMUX="$(tmux showenv -g -- TMUX 2> /dev/null)"; then
    unset -- TMUX_PANE
  fi

  PANES="$(tmux display-message -p -- '#{window_panes}')"
  if ((PANES == 1)); then
    ARGV=(tmux split-window -h)
  else
    ARGV=(tmux new-window -a)
  fi

  # shellcheck disable=SC2154
  exec -- "${ARGV[@]}" -- "$EDITOR" "$@"
else
  exec -- open -- "$@"
fi
