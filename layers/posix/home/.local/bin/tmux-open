#!/usr/bin/env -S -- bash -Eeu -o pipefail -O dotglob -O nullglob -O extglob -O failglob -O globstar

set -o pipefail

if [[ -v TMUX ]]; then
  PANES="$(tmux display-message -p -- '#{window_panes}')"
  if ((PANES == 1)); then
    ARGV=(tmux split-window -h)
  else
    ARGV=(tmux new-window -a)
  fi

  # shellcheck disable=SC2154
  exec -- "${ARGV[@]}" -- "$EDITOR" "$@"
else
  exec -- open -- "$@"
fi
