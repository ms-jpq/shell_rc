#!/usr/bin/env -S -- bash -Eeu -o pipefail -O dotglob -O nullglob -O extglob -O failglob -O globstar

set -o pipefail

for F in "$@"; do
  if ! [[ $F =~ ^https?:// ]] && ! [[ -r $F ]]; then
    printf -- "%q" "Not openable -- $F" >&2
    exit 2
  fi
done

if [[ -v TMUX ]]; then
  FOCUS=0
  if [[ -v TMUX_PANE ]]; then
    FOCUS="$(tmux display-message -p -t "$TMUX_PANE" -- '#{&&:#{pane_active},#{window_active}}')"
  fi

  while OUTER="$(tmux show-environment -g -- TMUX 2> /dev/null)"; do
    export -- TMUX="${OUTER#TMUX=}"
    unset -- TMUX_PANE
  done

  PANES="$(tmux display-message -p -- '#{window_panes}')"
  if ((PANES == 1)); then
    ARGV=(tmux split-window -h)
  else
    ARGV=(tmux new-window -a)
  fi

  if ! ((FOCUS)); then
    ARGV+=(-d)
  fi

  if [[ -d $* ]]; then
    ARGV+=(-c "$*")
    exec -- "${ARGV[@]}"
  fi

  # shellcheck disable=SC2154
  exec -- "${ARGV[@]}" -- "$EDITOR" "$@"
else
  exec -- open -- "$@"
fi
