#!/usr/bin/env -S -- bash -Eeu -o pipefail -O dotglob -O nullglob -O extglob -O globstar

set -o pipefail

OPT="$HOME/.local/opt/helix"
RT="$HOME/.cache/helix-rt"

HX="$OPT/target/release/hx"
if ! [[ -x $HX ]]; then
  case "$OSTYPE" in
  linux*)
    HX='/usr/bin/hx'
    ;;
  darwin*)
    HX='/opt/homebrew/bin/hx'
    ;;
  msys)
    HX='/usr/bin/hx'
    ;;
  *)
    set -x
    exit 1
    ;;
  esac
fi

export -- HELIX_RUNTIME="$OPT/runtime"

if [[ ! -d $HELIX_RUNTIME ]]; then
  case "$OSTYPE" in
  linux*)
    export -- HELIX_RUNTIME='/usr/lib/helix/runtime'
    ;;
  darwin*)
    export -- HELIX_RUNTIME='/opt/homebrew/opt/helix/libexec/runtime'
    ;;
  *) ;;
  esac
fi

PATHS=(
  "$HOME/.config/helix/bin"
  "$RT/bin"
  "$RT/"{more,go,ruby}/*/bin
  "$RT/nodejs"/*/node_modules/.bin
  "$RT/python"/*/venv/{Scripts,bin}
  "$PATH"
)
IFS=':'
# shellcheck disable=SC2154
PATH="${PATHS[*]}"

exec -- "$HX" --config "$HOME/.config/helix/config.toml" "$@"
