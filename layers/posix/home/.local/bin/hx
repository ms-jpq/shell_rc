#!/usr/bin/env -S -- bash -Eeu -o pipefail -O dotglob -O nullglob -O extglob -O failglob -O globstar

set -o pipefail
shopt -u failglob

OPT="$HOME/.local/opt/helix"

HX="$OPT/target/release/hx"
if ! [[ -x $HX ]]; then
  readarray -t -d ':' -- DIRS < <(printf -- '%s' "$PATH")

  HX=''
  SEEN=0
  for D in "${DIRS[@]}"; do
    if [[ -x "$D/hx" ]] && ((SEEN++)); then
      HX="$D/hx"
      break
    fi
  done

  if [[ -z $HX ]]; then
    set -v
    exit 1
  fi
fi

export -- HELIX_RUNTIME="$OPT/runtime"

if [[ ! -d $HELIX_RUNTIME ]]; then
  case "$OSTYPE" in
  linux*)
    export -- HELIX_RUNTIME='/usr/lib/helix/runtime'
    ;;
  darwin*)
    export -- HELIX_RUNTIME='/opt/homebrew/opt/helix/libexec/runtime'
    ;;
  *) ;;
  esac
fi

exec -- hp "$HX" --config "$HOME/.config/helix/config.toml" "$@"
