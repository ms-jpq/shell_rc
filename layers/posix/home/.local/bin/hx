#!/usr/bin/env -S -- bash -Eeu -o pipefail -O dotglob -O nullglob -O extglob -O globstar

set -o pipefail

OPT="$HOME/.local/opt/helix"

HX="$OPT/target/release/hx"
if ! [[ -x $HX ]]; then
  case "$OSTYPE" in
  linux*)
    HX='/usr/bin/hx'
    ;;
  darwin*)
    HX='/opt/homebrew/bin/hx'
    ;;
  msys)
    HX='/usr/bin/hx'
    ;;
  *)
    set -v
    exit 1
    ;;
  esac
fi

export -- HELIX_RUNTIME="$OPT/runtime"

if [[ ! -d $HELIX_RUNTIME ]]; then
  case "$OSTYPE" in
  linux*)
    export -- HELIX_RUNTIME='/usr/lib/helix/runtime'
    ;;
  darwin*)
    export -- HELIX_RUNTIME='/opt/homebrew/opt/helix/libexec/runtime'
    ;;
  *) ;;
  esac
fi

exec -- hp "$HX" --config "$HOME/.config/helix/config.toml" "$@"
