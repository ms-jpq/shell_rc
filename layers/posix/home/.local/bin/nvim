#!/usr/bin/env -S -- bash -Eeu -o pipefail -O dotglob -O nullglob -O extglob -O failglob -O globstar

set -o pipefail
shopt -u failglob

readarray -t -d ':' -- DIRS < <(printf -- '%s' "$PATH")

NVIM=''
SEEN=0
for D in "${DIRS[@]}"; do
  if [[ -x "$D/nvim" ]] && ((SEEN++)); then
    NVIM="$D/nvim"
    break
  fi
done

if [[ -z $NVIM ]]; then
  set -x
  exit 1
fi

ARGV=("$NVIM")

if [[ -v NVIM_SERVERNAME ]]; then
  ARGV+=(
    --server "$NVIM_SERVERNAME"
    --remote
  )
fi

QF=()
for F in "$@"; do
  if [[ $F =~ ^[^:]+(:[0-9]+){1,2}:? ]]; then
    if [[ $F =~ [^:](:[0-9]+){2}$ ]]; then
      F="$F:-"
    elif [[ $F =~ [^:](:[0-9]+){1}$ ]]; then
      F="$F:0:-"
    fi

    QF+=("$F")
  fi
done

if (($#)) && ((${#QF[@]} == $#)); then
  TMP="$(mktemp)"
  printf -- '%s\n' "${QF[@]}" > "$TMP"
  exec -- "${ARGV[@]}" -q "$TMP"
else
  exec -- "${ARGV[@]}" "$@"
fi
