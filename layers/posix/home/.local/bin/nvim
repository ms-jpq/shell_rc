#!/usr/bin/env -S -- bash -Eeu -o pipefail -O dotglob -O nullglob -O extglob -O globstar

set -o pipefail

NVIM='nvim'

case "$OSTYPE" in
linux*)
  NVIM='/usr/bin/nvim'
  ;;
darwin*)
  NVIM='/opt/homebrew/bin/nvim'
  ;;
msys) ;;
*)
  set -v
  exit 1
  ;;
esac

if ! command -v -- "$NVIM" > /dev/null; then
  set -v
  exit
fi

ARGV=("$NVIM")

if [[ -v NVIM_SERVERNAME ]]; then
  ARGV+=(
    --server "$NVIM_SERVERNAME"
    --remote
  )
fi

QF=()
for F in "$@"; do
  if [[ $F =~ ^[^:]+(:[0-9]+){1,2}:? ]]; then
    if [[ $F =~ [^:](:[0-9]+){2}$ ]]; then
      F="$F:-"
    elif [[ $F =~ [^:](:[0-9]+){1}$ ]]; then
      F="$F:0:-"
    fi

    QF+=("$F")
  fi
done

if (($#)) && ((${#QF[@]} == $#)); then
  TMP="$(mktemp)"
  printf -- '%s\n' "${QF[@]}" > "$TMP"
  exec -- "${ARGV[@]}" -q "$TMP"
else
  exec -- "${ARGV[@]}" "$@"
fi
