#!/usr/bin/env -S -- bash -Eeu -o pipefail -O dotglob -O nullglob -O extglob -O failglob -O globstar

set -o pipefail
shopt -u failglob

BASE="${0%/*}"
PATH=":$PATH:"
PATH="${PATH//:$BASE:/:}"
PATH="${PATH#:}"
PATH="${PATH%:}"

NVIM='nvim'

case "$OSTYPE" in
linux*)
  if [[ -x /usr/bin/nvim ]]; then
    NVIM='/usr/bin/nvim'
  fi
  ;;
darwin*)
  if [[ -x /opt/homebrew/bin/nvim ]]; then
    NVIM='/opt/homebrew/bin/nvim'
  fi
  ;;
msys | cygwin) ;;
*)
  set -v
  exit 1
  ;;
esac

ARGV=("$NVIM")

if [[ -v NVIM_SERVERNAME ]]; then
  ARGV+=(
    --server "$NVIM_SERVERNAME"
    --remote
  )
fi

QF=()
for F in "$@"; do
  if [[ $F =~ ^[^:]+(:[0-9]+){1,2}:? ]]; then
    if [[ $F =~ [^:](:[0-9]+){2}$ ]]; then
      F="$F:-"
    elif [[ $F =~ [^:](:[0-9]+){1}$ ]]; then
      F="$F:0:-"
    fi

    QF+=("$F")
  fi
done

if (($#)) && ((${#QF[@]} == $#)); then
  TMP="$(mktemp)"
  printf -- '%s\n' "${QF[@]}" > "$TMP"
  exec -- "${ARGV[@]}" -q "$TMP"
else
  exec -- "${ARGV[@]}" "$@"
fi
