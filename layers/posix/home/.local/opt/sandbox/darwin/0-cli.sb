(version 1)
(deny default (with message "dogged"))

; (deny default (with report))
; log stream --predicate 'sender == "Sandbox" or subsystem == "com.apple.sandbox.reporting"' --style compact
; log stream --predicate 'eventMessage CONTAINS "dogged" or subsystem == "com.apple.sandbox.reporting"' --style compact

(import "bsd.sb")

;; ---- ---- ---- ----

(allow file-read*
  (subpath "/bin")
  (subpath "/private/etc")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/libexec")
  (subpath "/usr/local")
  (subpath "/usr/sbin"))

(allow file-read* file-map-executable
  (subpath "/opt/homebrew"))

(allow file-read*
  (literal "/Library/Preferences/com.apple.networkd.plist"))

;; ---- ---- ---- ----

(allow file-read* file-write*
  (subpath "/private/tmp")
  (subpath "/private/var/tmp")
  (subpath (param "TMPDIR"))
  (subpath (param "CWD")))

;; ---- ---- ---- ----

(define (import-profile profile)
  (import (string-append (param "PROFILES") "/" profile)))

(define (home path)
  (string-append (param "HOME") "/" path))

(define (xdg-config path)
  (string-append (home "Library/Preferences") "/" path))

(define (xdg-cache path)
  (string-append (home "Library/Caches") "/" path))

(define (xdg-state path) (xdg-cache path))

(define (local-share path)
  (string-append (home "Library/Application Support") "/" path))

;; ---- ---- ---- ----

(deny file-read* file-write*
  (subpath
    (home "Desktop")
    (home "Documents")
    (home "Library")
    (home "Movies")
    (home "Music")
    (home "Pictures")
    (home "Public")))
