(version 1)
(deny default)

; (deny default (with report))
; log stream --predicate 'sender == "Sandbox" or subsystem == "com.apple.sandbox.reporting"' --style compact

(import "bsd.sb")

;; ---- ---- ---- ----

(allow mach-lookup)
(allow process-exec)
(allow process-fork)

(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))
(allow mach-priv-task-port (target same-sandbox))

(allow ipc-posix-shm)
(allow ipc-posix-sem)

(allow user-preference-read)

(allow file-ioctl
  (literal "/dev/dtracehelper")
  (literal "/dev/null")
  (literal "/dev/random")
  (literal "/dev/tty")
  (literal "/dev/urandom")
  (literal "/dev/zero"))

(allow system-socket (require-all (socket-domain AF_SYSTEM) (socket-protocol 2)))

;; ---- ---- ---- ----

(allow file-read* file-write* file-ioctl
  (literal "/dev/tty"))

(allow file-ioctl file-read-data file-write-data
  (require-all
    (literal "/dev/null")
    (vnode-type CHARACTER-DEVICE)))

;; ---- ---- ---- ----

(allow sysctl-write
  (sysctl-name "kern.tcsm_enable"))

(allow distributed-notification-post)

;; ---- ---- ---- ----

(allow iokit-open
  (iokit-registry-entry-class "IOSurfaceRootUserClient")
  (iokit-registry-entry-class "RootDomainUserClient")
  (iokit-user-client-class "IOSurfaceSendRight"))

(allow iokit-get-properties)

;; ---- ---- ---- ----

(allow file-read*
  (subpath "/bin")
  (subpath "/private/etc")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/libexec")
  (subpath "/usr/local")
  (subpath "/usr/sbin"))

(allow file-read* file-map-executable
  (subpath "/opt/homebrew"))

;; ---- ---- ---- ----

(allow file-read* file-write*
  (subpath "/private/tmp")
  (subpath "/private/var/tmp")
  (subpath (param "TMPDIR"))
  (subpath (param "CWD")))

;; ---- ---- ---- ----

(define (import-profile profile)
  (import (string-append (param "PROFILES") "/" profile)))

(define (home path)
  (string-append (param "HOME") "/" path))

(define (xdg-config path)
  (string-append (home "Library/Preferences") "/" path))

(define (xdg-cache path)
  (string-append (home "Library/Caches") "/" path))

(define (xdg-state path) (xdg-cache path))

(define (local-share path)
  (string-append (home "Library/Application Support") "/" path))

;; ---- ---- ---- ----

(deny file-read* file-write*
  (subpath
    (home "Desktop")
    (home "Documents")
    (home "Library")
    (home "Movies")
    (home "Music")
    (home "Pictures")
    (home "Public")))
