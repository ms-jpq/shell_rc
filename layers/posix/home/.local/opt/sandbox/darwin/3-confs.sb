(version 1)

(deny file-read* file-write*
  (subpath
    (home "Library")))

;; ---- ---- ---- ----

(allow file-read*
  (literal
    (home ".bashrc")
    (home ".netrc")
    (home ".tool-versions")
    (home ".zshenv")
  )
  (subpath
    (home ".gitconfig")
    (home ".local/bin")
    (home ".local/lbin")
    (home ".local/libexec")
    (home ".local/lprofile.d")
    (xdg-config "asdf")
    (xdg-config "bat")
    (xdg-config "bottom")
    (xdg-config "bundle")
    (xdg-config "cloc")
    (xdg-config "fzf")
    (xdg-config "gem")
    (xdg-config "git")
    (xdg-config "helix")
    (xdg-config "irb")
    (xdg-config "mpv")
    (xdg-config "mypy")
    (xdg-config "npm")
    (xdg-config "nvim")
    (xdg-config "posh")
    (xdg-config "powershell")
    (xdg-config "psql")
    (xdg-config "python")
    (xdg-config "readline")
    (xdg-config "rediscli")
    (xdg-config "ripgrep")
    (xdg-config "terraform")
    (xdg-config "tmux")
    (xdg-config "vim")
    (xdg-config "yazi")
    (xdg-config "zsh")
  ))

(allow file-read*
  (subpath
    (xdg-config "gh")))
