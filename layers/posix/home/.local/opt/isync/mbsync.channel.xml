<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>mbsync.${CHANNEL}</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>SASL_PATH</key>
      <string>/opt/homebrew/opt/cyrus-sasl/lib/sasl2:/opt/homebrew/opt/cyrus-sasl-xoauth2/lib/sasl2</string>
    </dict>
    <key>Program</key>
    <string>${HOME}/.local/opt/isync/launched.sh</string>
    <key>ProgramArguments</key>
    <array>
      <string>bash</string>
      <string>${CHANNEL}</string>
    </array>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>6</integer>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>QueueDirectories</key>
    <array>
      <string>${HOME}/.local/state/isync/mbsync.${CHANNEL}.queue</string>
    </array>
  </dict>
</plist>
