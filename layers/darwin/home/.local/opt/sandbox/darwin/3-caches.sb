(version 1)

(allow file-read* file-write*
  (subpath
    (xdg-cache "")))

(deny file-read* file-write*
  (regex
    (string-append "^" (xdg-cache "") "com\\.apple\\.")
    (string-append "^" (xdg-cache "") "nvim\\.")
    (string-append "^" (xdg-cache "askpermissiond"))
    (string-append "^" (xdg-cache "CloudKit"))
    (string-append "^" (xdg-cache "containers"))
    (string-append "^" (xdg-cache "Firefox"))
    (string-append "^" (xdg-cache "GameKit"))
    (string-append "^" (xdg-cache "maildir"))
  ))

