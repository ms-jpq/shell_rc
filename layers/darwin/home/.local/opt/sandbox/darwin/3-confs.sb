(version 1)

(allow file-read*
  (subpath
    (xdg-config "asdf")
    (xdg-config "bat")
    (xdg-config "bottom")
    (xdg-config "cloc")
    (xdg-config "gem")
    (xdg-config "git")
    (xdg-config "helix")
    (xdg-config "irb")
    (xdg-config "mpv")
    (xdg-config "mypy")
    (xdg-config "npm")
    (xdg-config "nvim")
    (xdg-config "posh")
    (xdg-config "powershell")
    (xdg-config "psql")
    (xdg-config "python")
    (xdg-config "readline")
    (xdg-config "ripgrep")
    (xdg-config "terraform")
    (xdg-config "tmux")
    (xdg-config "vim")
    (xdg-config "yazi")
    (xdg-config "zsh")))
